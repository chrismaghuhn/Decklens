{
  "name": "mtg-deckbuilder-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "train:cli": "npx tsx scripts/train-bot-cli.ts",
    "train:gpu": "npx tsx scripts/train-bot-cli.ts --backend gpu",
    "train:cpu": "npx tsx scripts/train-bot-cli.ts --backend cpu",
    "eval:cli": "npx tsx scripts/eval-bot-cli.ts"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.17.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.17.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@tensorflow/tfjs-node-gpu": "^4.22.0",
    "lz-string": "^1.5.0",
    "wrangler": "^4.65.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  }
}
